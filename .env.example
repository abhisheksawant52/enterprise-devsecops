# Copy to .env and adjust for your environment.
# All variables are prefixed EDSEC_ and map to enterprise_devsecops.config.Settings.

EDSEC_APP_NAME=enterprise-devsecops
EDSEC_ENVIRONMENT=development
EDSEC_LOG_LEVEL=INFO
EDSEC_LOG_JSON=false

EDSEC_HOST=0.0.0.0
EDSEC_PORT=8080

EDSEC_POLICY_PATH=policies/org-policy.yaml
EDSEC_DEFAULT_FAIL_ON=HIGH

# S3-compatible bucket (or equivalent) where scan reports are archived.
EDSEC_SCAN_REPORT_BUCKET=

EDSEC_SCANNER_TIMEOUT_SECONDS=900
